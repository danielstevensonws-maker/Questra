# Copy to .env.local (gitignored) and fill in. .env.local is loaded for dev/tests.
# NEVER commit real keys.

# --- database (ADR-0015 persistence) ---
# Matches docker-compose.yml's dev Postgres. Production sets its own.
DATABASE_URL=postgres://questra:questra_dev@localhost:5432/questra

# --- AI vendors (ADR-0015 vendor wiring; activate when keys are supplied) ---
# The RulingModel / ImageGen implementations read these; absent ⇒ the stubs +
# the difficulty-ladder fallback are used, so the app runs with no keys.
QUESTRA_RULING_API_KEY=
QUESTRA_IMAGE_API_KEY=
# Optional: pin the vendor/model per touchpoint (defaults chosen in code).
QUESTRA_RULING_MODEL=
QUESTRA_IMAGE_MODEL=
